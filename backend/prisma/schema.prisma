generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  password    String
  location    String?
  phone       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  predictions Prediction[]
}

model Prediction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  imagePath   String
  disease     String
  confidence  Float
  crop        String
  severity    String
  heatmapPath String?
  createdAt   DateTime @default(now())
}

model WeatherLog {
  id              String   @id @default(uuid())
  latitude        Float
  longitude       Float
  temperature     Float
  humidity        Float
  rainProbability Float
  windSpeed       Float
  recordedAt      DateTime @default(now())
}
